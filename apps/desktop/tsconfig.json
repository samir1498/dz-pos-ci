{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    // vite/client for the ?url and asset imports, node for the two tests that
    // read the source tree off disk (tokens.test.ts).
    "types": ["node", "vite/client"],
    "moduleResolution": "bundler",
    // Only `modules.config.mjs` needs this (C6): its exports carry JSDoc
    // types rather than a hand-kept `.d.ts` twin, since vite.config.ts and
    // scripts/build.mjs both load it as plain Node ESM (see that file's own
    // header for why it is not `.ts`).
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"]
}