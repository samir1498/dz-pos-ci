{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "dz-pos",
  "version": "0.1.0",
  "identifier": "com.dzpos.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "dz-pos",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true,
        "resizable": true,
        "decorations": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://127.0.0.1:* ipc://localhost http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "UNSET-waiting-on-anouar-and-samir-docs/architecture.md#release",
      "endpoints": [
        "https://github.com/Dinar-dz/dz-pos/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Samir Bettahar",
    "copyright": "Copyright (c) 2026 Samir Bettahar",
    "category": "Business",
    "shortDescription": "Stock management for small businesses",
    "longDescription": "Inventory, sales and invoicing for Algerian shops.",
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
