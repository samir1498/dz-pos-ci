---
import type { Dict } from "../i18n";

interface Props {
  readonly audience: Dict["audience"];
}

const { audience } = Astro.props;
---

<section class="audience" aria-labelledby="audience-heading">
  <div class="wrap">
    <h2 id="audience-heading">{audience.heading}</h2>
    <p>{audience.body}</p>
  </div>
</section>

<style>
  .audience {
    padding-block: var(--space-12);
  }

  .audience h2 {
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  .audience p {
    color: var(--text-secondary);
    margin-block-start: var(--space-3);
    max-width: 60ch;
    font-size: var(--text-lg);
  }
</style>
