---
// The page shell: the document, the brand row, and the sections in the order
// context/plans/20260911-landing-page.md sets. The brand appears once, in the
// header; the hero carries the page's only <h1>. `dict.tagline` is the
// document's one-line description and is not printed twice on the page.
import "../styles/base.css";

import markUrl from "@dzpos/design/assets/mark.svg?url";
import shots from "../lib/shots.json";
import { dictionaries } from "../i18n";
import type { Locale } from "../i18n";
import Hero from "../components/Hero.astro";
import Pieces from "../components/Pieces.astro";
import Fiscal from "../components/Fiscal.astro";
import Languages from "../components/Languages.astro";
import Screens from "../components/Screens.astro";
import Audience from "../components/Audience.astro";
import Pricing from "../components/Pricing.astro";

interface Props {
  readonly locale: Locale;
  /** This route's own script's woff2 files (src/lib/fonts.ts), preloaded so
   * the browser starts the font fetch alongside the HTML instead of after
   * it discovers the @font-face rule in the route's CSS. */
  readonly fontUrls: readonly string[];
}

const { locale, fontUrls } = Astro.props;
const dict = dictionaries[locale];
// The Lighthouse mobile run flagged the hero shot as not discoverable early
// enough for LCP (it is the page's largest above-the-fold element in every
// locale): a preload with the same srcset it renders with lets the browser
// start that fetch from the HTML instead of only after it lays out
// Hero.astro's <img>. Same file, same responsive choice, no new shot.
const heroShot = shots.hero[locale];
---

<!doctype html>
<html lang={dict.lang} dir={dict.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{dict.title}</title>
    <meta name="description" content={dict.tagline} />
    {
      fontUrls.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
      ))
    }
    <link
      rel="preload"
      as="image"
      href={`/shots/${heroShot.src1x}`}
      imagesrcset={`/shots/${heroShot.src1x} 1x, /shots/${heroShot.src2x} 2x`}
    />
  </head>
  <body>
    <header class="site-header">
      {/* alt="" for the same reason as Wordmark.tsx: the word beside the
          coin is already the accessible name. */}
      <img src={markUrl} width="28" height="28" alt="" />
      <span>{dict.brandWord} <strong>{dict.brandSuffix}</strong></span>
    </header>
    <main>
      <Hero locale={locale} hero={dict.hero} />
      <Pieces locale={locale} pieces={dict.pieces} />
      <Fiscal fiscal={dict.fiscal} />
      <Languages languages={dict.languages} />
      <Screens locale={locale} screens={dict.screens} />
      <Audience audience={dict.audience} />
      <Pricing pricing={dict.pricing} />
    </main>
  </body>
</html>
