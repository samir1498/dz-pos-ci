{
  "mcpServers": {
    "pc-ctx": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@pc-ctx/mcp@0.8.0"],
      "env": {
        "PC_CTX_ROOT": "/home/samir/dz-pos/context",
        "PC_CTX_RESEARCH_DIR": "/home/samir/dz-pos/research"
      }
    },
    "sonarqube": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--init",
        "--rm",
        "-i",
        "--network",
        "host",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_URL",
        "sonarsource/sonarqube-mcp"
      ],
      "env": {
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "SONARQUBE_URL": "${SONARQUBE_URL:-https://sonar.observeone.com}"
      }
    }
  }
}
